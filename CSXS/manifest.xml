<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
  ExtensionBundleId="com.utilitystudio.panel"
  ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="UtilityStudio">

  <ExtensionList>
    <Extension Id="com.utilitystudio.panel" Version="0.1.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.utilitystudio.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--enable-webgl</Parameter>
            <Parameter>--ignore-gpu-blacklist</Parameter>
            <Parameter>--ignore-gpu-blocklist</Parameter>
            <Parameter>--enable-gpu-rasterization</Parameter>
            <Parameter>--autoplay-policy=no-user-gesture-required</Parameter>
          </CEFCommandLine>
        </Resources>

        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Utility Studio</Menu>
          <Geometry>
            <Size>
              <Height>520</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>120</Height>
              <Width>200</Width>
            </MinSize>
            <MaxSize>
              <Height>1200</Height>
              <Width>1200</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
